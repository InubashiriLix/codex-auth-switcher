use super::{draw, Modal, Ui};
use crate::error::Result;
use crossterm::event::{self, Event, KeyCode, KeyEvent, KeyModifiers};
use ratatui::{Terminal, backend::CrosstermBackend};
use std::{
    io,
    time::{Duration, Instant},
};

const TICK_RATE: Duration = Duration::from_millis(100);

pub fn run_tui(terminal: &mut Terminal<CrosstermBackend<io::Stdout>>, ui: &mut Ui) -> Result<()> {
    let mut last_tick = Instant::now();

    loop {
        terminal.draw(|f| draw(f, ui))?;

        let timeout = TICK_RATE.saturating_sub(last_tick.elapsed());

        if event::poll(timeout)? {
            if let Event::Key(key) = event::read()? {
                if handle_key(key, ui)? {
                    return Ok(());
                }
            }
        }

        if last_tick.elapsed() >= TICK_RATE {
            ui.tick += 1;
            last_tick = Instant::now();
        }
    }
}

pub fn handle_key(key: KeyEvent, ui: &mut Ui) -> Result<bool> {
    // Ctrl+C 退出
    if key.modifiers.contains(KeyModifiers::CONTROL) && key.code == KeyCode::Char('c') {
        return Ok(true);
    }

    // 如果有modal，处理modal逻辑
    if ui.modal != Modal::None {
        return handle_modal(key, ui);
    }

    // 主界面按键处理
    match (key.modifiers, key.code) {
        (_, KeyCode::Char('q')) => return Ok(true),
        (_, KeyCode::Esc) => {
            ui.filter.clear();
            ui.notice = "已清除过滤".into();
        }
        (_, KeyCode::Char('j')) | (_, KeyCode::Down) => {
            let visible = ui.visible();
            if !visible.is_empty() {
                ui.selected = (ui.selected + 1).min(visible.len() - 1);
            }
        }
        (_, KeyCode::Char('k')) | (_, KeyCode::Up) => {
            ui.selected = ui.selected.saturating_sub(1);
        }
        (_, KeyCode::Char('?')) => {
            ui.modal = Modal::Help;
        }
        (_, KeyCode::Char('m')) => {
            ui.modal = Modal::ModeSelector;
        }
        (_, KeyCode::Char('t')) => {
            ui.config.theme = ui.config.theme.next();
            ui.notice = format!("已切换主题：{}", ui.config.theme.name());
        }
        _ => {}
    }

    Ok(false)
}

fn handle_modal(key: KeyEvent, ui: &mut Ui) -> Result<bool> {
    match key.code {
        KeyCode::Esc => {
            ui.modal = Modal::None;
            ui.input.clear();
        }
        KeyCode::Char('q') if ui.modal == Modal::Help => {
            ui.modal = Modal::None;
        }
        KeyCode::Enter => {
            ui.modal = Modal::None;
            ui.input.clear();
        }
        KeyCode::Backspace => {
            ui.input.pop();
        }
        KeyCode::Char(c) => {
            if matches!(
                ui.modal,
                Modal::Import | Modal::Filter | Modal::Rename | Modal::Settings | Modal::ProxySettings
            ) {
                ui.input.push(c);
            }
        }
        _ => {}
    }

    Ok(false)
}
